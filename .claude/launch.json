{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app-cartera",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "--with-requirements",
        "requirements.txt",
        "streamlit",
        "run",
        "app.py",
        "--server.port",
        "8793",
        "--server.headless",
        "true"
      ],
      "port": 8793
    },
    {
      "name": "movil",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8794",
        "--directory",
        "docs/movil"
      ],
      "port": 8794
    }
  ]
}